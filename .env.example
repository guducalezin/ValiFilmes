PORT=3000
HOST=127.0.0.1
NODE_ENV=development
DEMO_MODE=true
DATA_DIR=./data
# Gere com: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=cole-aqui-uma-chave-aleatoria-base64-de-32-bytes
# Opcional: API Key v3 TMDB para já carregar filmes no modo de demonstração.
# Você também pode salvá-la pela tela Configurações, sem expor a chave ao navegador.
TMDB_API_KEY=
